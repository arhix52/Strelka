{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Bootstrap (Debug)",
            "type": "process",
            "command": "${workspaceFolder}/build.sh",
            "args": ["Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Bootstrap (Release)",
            "type": "process",
            "command": "${workspaceFolder}/build.sh",
            "args": ["Release"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build StrelkaEditor (Debug)",
            "type": "shell",
            "command": "ninja -C ${workspaceFolder}/build/Debug StrelkaEditor",
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"],
            "windows": {
                "type": "process",
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/scripts/build_editor_win.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "OPTIX_DIR": "C:\\ProgramData\\NVIDIA Corporation\\OptiX SDK 9.1.0"
                    }
                },
                "problemMatcher": ["$msCompile"]
            }
        },
        {
            "label": "Build StrelkaEditor (Release)",
            "type": "shell",
            "command": "ninja -C ${workspaceFolder}/build/Release StrelkaEditor",
            "options": {"cwd": "${workspaceFolder}"},
            "group": "build",
            "problemMatcher": ["$gcc"],
            "windows": {
                "type": "process",
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/scripts/build_editor_win.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "OPTIX_DIR": "C:\\ProgramData\\NVIDIA Corporation\\OptiX SDK 9.1.0"
                    }
                },
                "problemMatcher": ["$msCompile"]
            }
        },
        {
            "label": "Build unit_tests (Debug)",
            "type": "shell",
            "command": "ninja -C ${workspaceFolder}/build/Debug unit_tests",
            "options": {"cwd": "${workspaceFolder}"},
            "group": "test",
            "problemMatcher": ["$gcc"],
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "call build\\Release\\generators\\conanbuild.bat && cmake --build build\\Release --target unit_tests -j 24"
                ],
                "options": {"cwd": "${workspaceFolder}"},
                "problemMatcher": ["$msCompile"]
            }
        },
        {
            "label": "Run StrelkaEditor",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/run_editor_win.ps1",
                "-Build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "OPTIX_DIR": "C:\\ProgramData\\NVIDIA Corporation\\OptiX SDK 9.1.0"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false
            }
        },
        {
            "label": "Run unit_tests (Debug)",
            "type": "process",
            "command": "${workspaceFolder}/build/Debug/unit_tests",
            "dependsOn": "Build unit_tests (Debug)",
            "options": {"cwd": "${workspaceFolder}/build/Debug"},
            "group": "test",
            "problemMatcher": [],
            "windows": {
                "command": "${workspaceFolder}/build/Release/unit_tests.exe",
                "options": {"cwd": "${workspaceFolder}/build/Release"}
            }
        }
    ]
}
