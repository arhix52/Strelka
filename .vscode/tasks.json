{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                ".",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build/Debug"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build Strelka (Debug) using cmake"
        },
        {
            "label": "CMake Build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                ".",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build/Release"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build Strelka (Release) using cmake"
        },
        {
            "label": "Conan Install + CMake Configure (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "conan install . -c tools.cmake.cmaketoolchain:generator=Ninja -c tools.system.package_manager:mode=install -c tools.system.package_manager:sudo=True --build=missing --settings=build_type=Debug && cd build/Debug && source ./generators/conanbuild.sh && cmake ../.. -G Ninja -DCMAKE_TOOLCHAIN_FILE=generators/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Run conan install and cmake configure for Debug"
        },
        {
            "label": "Full Build (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/build.sh",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Full build: conan install + configure + build (Debug)"
        },
        {
            "label": "Run Clang-Tidy",
            "type": "shell",
            "command": "clang-tidy",
            "args": [
                "-system-headers=0",
                "-fix-errors",
                "--fix",
                "--format-style=file",
                "${file}"
            ],
            "problemMatcher": []
        }
    ]
}
