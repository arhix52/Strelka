{
    // Disable Microsoft C/C++ intellisense in favor of clangd
    "C_Cpp.intelliSenseEngine": "disabled",

    // clangd: prefer workspace-root compile_commands.json (symlinked by build.sh
    // after a Debug configure); fall back to the Debug build dir.
    "clangd.path": "clangd",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--clang-tidy",
        "--background-index"
    ],

    "editor.formatOnSave": false,

    // Resolve via PATH (Homebrew llvm on Apple Silicon is not /usr/bin).
    "clang-format.executable": "clang-format",

    // Disable makefile-tools intellisense (conflicts with clangd)
    "makefile.configureOnOpen": false,

    "files.associations": {
        "*.ipp": "cpp",
        "*.tcc": "cpp"
    }
}
