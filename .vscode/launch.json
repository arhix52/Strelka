{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch StrelkaEditor (Debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/StrelkaEditor",
            "args": ["-s", "${input:sceneFile}"],
            "cwd": "${workspaceFolder}/build/Debug",
            "env": {
                "SPDLOG_LEVEL": "trace"
            },
            "preLaunchTask": "CMake Build (Debug)"
        },
        {
            "name": "Launch StrelkaEditor (Release)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/StrelkaEditor",
            "args": ["-s", "${input:sceneFile}"],
            "cwd": "${workspaceFolder}/build/Release",
            "env": {
                "SPDLOG_LEVEL": "info"
            },
            "preLaunchTask": "CMake Build (Release)"
        },
        {
            "name": "Launch StrelkaEditor (Debug + Metal validation)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/StrelkaEditor",
            "args": ["-s", "${input:sceneFile}"],
            "cwd": "${workspaceFolder}/build/Debug",
            "env": {
                "SPDLOG_LEVEL": "trace",
                "MTL_DEBUG_LAYER": "1",
                "MTL_SHADER_VALIDATION": "1"
            },
            "preLaunchTask": "CMake Build (Debug)"
        },
        {
            "name": "Run unit tests (Debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/unit_tests",
            "args": [],
            "cwd": "${workspaceFolder}/build/Debug",
            "preLaunchTask": "CMake Build (Debug)"
        },
        {
            "name": "(Windows) Launch StrelkaEditor (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/StrelkaEditor.exe",
            "args": ["-s", "${input:sceneFile}"],
            "cwd": "${workspaceFolder}/build/Debug",
            "environment": [
                {
                    "name": "SPDLOG_LEVEL",
                    "value": "info"
                }
            ],
            "stopAtEntry": false,
            "preLaunchTask": "CMake Build (Debug)"
        }
    ],
    "inputs": [
        {
            "id": "sceneFile",
            "type": "promptString",
            "description": "Path to .gltf/.glb scene file (leave empty to start with an empty scene)",
            "default": ""
        }
    ]
}
