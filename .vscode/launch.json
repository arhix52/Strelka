{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Linux) Launch StrelkaEditor",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/src/editor/StrelkaEditor",
            "args": ["-s", "${input:sceneFile}"],
            "cwd": "${workspaceFolder}/build/Debug",
            "env": {
                "SPDLOG_LEVEL": "trace"
            },
            "preLaunchTask": "CMake Build (Debug)"
        },
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/src/editor/StrelkaEditor.exe",
            "args": ["-s", "C:/work/vespa/vespa.gltf", "-v"],
            "environment": [
                {
                    "name": "SPDLOG_LEVEL",
                    "value": "info"
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/"
        },
        {
            "name": "(Mac) Launch",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/src/editor/StrelkaEditor",
            "args": ["-s", "${input:sceneFile}"],
            "cwd": "${workspaceFolder}/build/Debug/",
            "env": {
                "SPDLOG_LEVEL": "trace",
                "MTL_DEBUG_LAYER": "1"
            },
            "preLaunchTask": "CMake Build (Debug)"
        }
    ],
    "inputs": [
        {
            "id": "sceneFile",
            "type": "promptString",
            "description": "Path to .gltf scene file",
            "default": "/home/ilya/work/BrainStem/brainStem.gltf"
        }
    ]
}
