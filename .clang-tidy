# Folded scalar (>) — a plain '<' would disable every check silently.
#
# What this is for, in order: correctness, undefined behaviour, performance.
# Those are the four families in WarningsAsErrors below, and they are the only
# ones allowed to stop a build. Everything else is advisory.
#
# modernize-* is on as advisory, to walk the codebase towards current C++ — but
# only the checks that change what the code *is*, not how it is spelled. A
# thousand diagnostics nobody intends to act on is how the hundred that matter
# get ignored, so the spelling-only ones are off, with what each was producing
# over the tree (note that YAML's folded scalar takes no comments, hence here):
#
#   use-trailing-return-type      1348   and against the house style
#   avoid-c-style-cast             916   device code casts C-style by necessity
#   use-nodiscard                  202
#   use-designated-initializers    177   the GPU-facing structs are hand-packed
#   avoid-c-arrays                 164   mostly device-facing storage
#   use-auto                       141   this codebase spells its types out
#
# readability-* and hicpp-* stay off for the same reason.
#
# modernize-use-std-numbers is off for a structural reason rather than a
# stylistic one. Every host site was converted to std::numbers; what is left, and
# cannot be, is M_PI_F in the material and shader headers -- <numbers> exists
# under neither the Metal compiler nor NVCC, and the point of that constant is
# that all three compilers see the same one. Those headers are pulled into a
# dozen host translation units apiece, so the check was printing 474 lines per
# build, 63% of everything the analyzer had to say.
#
# The fixed-seed checks are off because a fixed seed is the point: a renderer's
# tests have to produce the same image twice, and a sampler seeded from the clock
# is not reproducible. It takes three entries -- bugprone-random-generator-seed
# plus the cert-msc32-c / cert-msc51-cpp aliases -- because disabling one spelling
# leaves the other two reporting the same line, and cert-* is in
# WarningsAsErrors, so it fails the build rather than merely warning.
#
# src/material/ and src/shaders/ carry their own .clang-tidy: those headers are
# compiled by NVCC and the Metal compiler as well as by the host toolchain, so a
# suggestion to reach for the C++ standard library is not actionable there.
# HeaderFilterRegex limits diagnostics to our trees; third_party/ and external/
# have their own .clang-tidy with Checks: '-*'.
Checks: >
  *,
  -android-*,
  -abseil-*,
  -altera-*,
  -boost-*,
  -darwin-*,
  -fuchsia-*,
  -google-*,
  -objc-*,
  -zircon-*,
  -llvm*,
  -readability-*,
  -hicpp-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-style-cast,
  -modernize-use-nodiscard,
  -modernize-use-designated-initializers,
  -modernize-avoid-c-arrays,
  -modernize-use-auto,
  -modernize-use-std-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-virtual-class-destructor,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-use-enum-class,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -misc-static-assert,
  -performance-enum-size,
  -portability-avoid-pragma-once,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-random-generator-seed,
  -cert-env33-c,
  -cert-err58-cpp,
  -cert-msc32-c,
  -cert-msc51-cpp

# The two analyzer checks excluded here fire *inside* header-only third-party
# libraries -- stb_image.h, tinyexr.h, doctest.h -- which are compiled into our
# own translation units. Analyzer diagnostics ignore HeaderFilterRegex and
# ExcludeHeaderFilterRegex both (they are reported at the point the bug
# materialises, whoever's header that is), so there is no way to keep them as
# errors without a vendored library failing our build. They still report as
# warnings, which is where anything of ours in those families would show up.
#
# clang-analyzer-osx.cocoa.RetainCount stays an error, and earned it: it is what
# caught three leaked MetalFX descriptors in a file compiled without ARC.
WarningsAsErrors: >
  bugprone-*,
  clang-analyzer-*,
  -clang-analyzer-unix.Malloc,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  performance-*,
  concurrency-*,
  cert-*

HeaderFilterRegex: '(src|tests)/.*'
SystemHeaders: false
FormatStyle: none

CheckOptions:
  - key: cppcoreguidelines-explicit-virtual-functions.IgnoreDestructors
    value: '1'
